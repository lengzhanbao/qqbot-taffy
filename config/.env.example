# QQBot 环境变量示例
# 用法：复制为项目根目录下的 .env，再填写真实值。
# 不要把真实 .env 提交到代码仓库；备份脚本会把 .env 备份到 backups/。

# NapCat / OneBot 连接
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:6099

# 触发和权限
QQ_TRIGGER=at
QQ_ADMIN_UIDS=your_qq_uid_here

# 输出
QQ_MAX_OUTPUT_TOKENS=10000
QQ_GUIDE_OUTPUT_TOKENS=10000

# 角色与风格
QQ_TAFFY_FLAVOR=1
# Compact first-pass persona; 0 restores the layered style prompt.
QQ_TAFFY_LIGHT_MODE=1
# Provider model ID, without the deepseek/ prefix. Match your API account.
QQ_DEEPSEEK_MODEL=deepseek-flash

# 人格还原档位（low / standard / high），与下面的整活强度解耦。
# L3 != 人格还原度最高：L3 只是"整活/抽象"更强。推荐核心人格一直 high，
# 整活强度用 L2 按场景动态调整，避免普通闲聊被过度抽象。
QQ_PERSONA_FIDELITY=high
# 是否按场景注入少量原创节奏示例（不是本人语录，勿照抄）
QQ_PERSONA_FEWSHOT=1
# 二次模型人格重写：默认关闭（多一次调用、更慢、易失真）
QQ_PERSONA_REWRITE=0

# 整活/抽象强度上限：0=关闭，1=自嘲，2=调侃现象，3=高级黑
QQ_STYLE_LEVEL=2
QQ_ALLOW_L3=0
QQ_DISABLE_ABSTRACT_ON_SENSITIVE=1

# 搜索与响应
QQ_ALWAYS_SEARCH=1
QQ_SEND_THINKING=1
QQ_REFLECTION=0
QQ_GROUP_STYLE_LEARNING=0
# New knowledge ledger; requires explicit per-group grants as well.
QQ_KNOWLEDGE_SYSTEM=0
# Persistent L2/L3/L4 store. Existing per-group grants and personal consent still apply.
# Opt-in after offline validation; does not migrate or replace legacy files.
QQ_AGENT_MEMORY=0
QQ_AGENT_MEMORY_LIMIT_GB=20
# Read-only local BGE folder; model downloads are never automatic.
QQ_AGENT_MEMORY_EMBEDDING_PATH=
# All observation, learning and proactive features require GroupPolicy grants.
# A global switch never grants consent. See docs/group_learning_implementation.md.
# 自主群聊接话：默认关闭，必须逐群授权 proactive_chat 才生效。
# 目标是"在合适的时候自然插话"，不是说得越多越好，所以限额偏保守。
QQ_PROACTIVE_GROUP_CHAT=0
# 同一群两次主动发言的最小间隔（秒）
QQ_PROACTIVE_GROUP_COOLDOWN=900
# 全局最小间隔（秒），防止多个群同时被接话
QQ_PROACTIVE_GLOBAL_COOLDOWN=60
# Generation attempts, including silence/failure, have a separate short backoff.
QQ_PROACTIVE_ATTEMPT_BACKOFF=15
QQ_PROACTIVE_MAX_TOKENS=1024
# 每群每小时上限
QQ_PROACTIVE_HOURLY_LIMIT=2
# 每群每天上限
QQ_PROACTIVE_DAILY_LIMIT=8
# 机会评分阈值：越高越保守（规则打分，不调用模型）
QQ_PROACTIVE_SCORE_THRESHOLD=2
QQ_CONTEXT_MAX_MESSAGES=100
QQ_HISTORY_CONTEXT_MAX_CHARS=18000
# 会话摘要触发阈值（字符）。原默认 110000 高于真实最大会话（706 条约 80000 字符），
# 会导致摘要永远不生成、"聊过就忘"。按真实数据下调为 30000。
QQ_COMPRESS_TRIGGER_CHARS=30000
# 摘要时保留的最近内容（字符），这段不压缩
QQ_COMPRESS_KEEP_RECENT_CHARS=20000
# 单次摘要调用的输入上限（字符）：长会话分多次增量摘要，避免一次塞进超大 prompt
QQ_COMPRESS_MAX_BATCH_CHARS=12000
QQ_API_TIMEOUT=30
QQ_API_CONNECT_TIMEOUT=12
QQ_TOOL_CALL_TIMEOUT=8
QQ_GLM_WEB_SEARCH=1
QQ_GLM_WEB_SEARCH_ENGINE=search_pro
QQ_GLM_WEB_SEARCH_COUNT=10
QQ_MAX_SEARCH_CHARS=6000
QQ_SEARCH_SNIPPET_CHARS=600
QQ_SEARCH_DISTILL_CHARS=600
QQ_MAX_PAGE_TEXT_CHARS=12000
QQ_MAX_LYRIC_CONTEXT_CHARS=24000
QQ_DRISSION_SEARCH=1
QQ_DRISSION_SEARCH_TIMEOUT=8
QQ_SEARCH_CACHE_TTL=300
# 自动找 Chrome/Edge；特殊路径可在这里写死
QQ_BROWSER_PATH=

# 采样参数
QQ_FACTUAL_TEMPERATURE=0.7
QQ_FACTUAL_TOP_P=0.8
QQ_CASUAL_TEMPERATURE=1.1
QQ_CASUAL_TOP_P=1.0

# API Key 占位
DEEPSEEK_API_KEY=your_api_key_here
GLM_API_KEY=your_api_key_here
OPENCODE_GO_API_KEY=your_api_key_here
# OpenCode Go 套餐的 OpenAI 兼容端点（openai-compatible 模型走这个）
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_FREE_API_KEY=your_api_key_here
OPENCODE_FREE_BASE_URL=https://opencode.ai/zen/v1

# 最终回复模型（provider/model）。留空则用 QQ_DEEPSEEK_MODEL 拼成 deepseek/<id>。
# 例：走 OpenCode Go 套餐 -> opencode/deepseek-v4.1-flash
QQ_FINAL_MODEL=
# 可选兜底模型：主模型不可用（未订阅/额度耗尽）时自动回落，避免机器人哑掉。
QQ_FINAL_FALLBACK_MODEL=
# 调用模型时的客户端标识。OpenCode 要求自有 user agent，不能用通用 SDK 名。
QQ_API_USER_AGENT=QQBot-Taffy/1.0 (+https://github.com/lengzhanbao/qqbot-taffy)
