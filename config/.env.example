# QQBot 环境变量示例
# 用法：复制为 <项目根>\.env，再填写真实值。
# 不要把真实 .env 提交到代码仓库；备份脚本会把 .env 备份到 <项目根>\backups。

# NapCat / OneBot 连接
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:6099

# 触发和权限
QQ_TRIGGER=at
QQ_ADMIN_UIDS=your_qq_uid_here

# 输出
QQ_MAX_OUTPUT_TOKENS=10000
QQ_GUIDE_OUTPUT_TOKENS=10000

# 角色与风格
QQ_TAFFY_FLAVOR=1
QQ_STYLE_LEVEL=2
QQ_ALLOW_L3=0
QQ_DISABLE_ABSTRACT_ON_SENSITIVE=1

# 搜索与响应
QQ_ALWAYS_SEARCH=0
QQ_SEND_THINKING=1
QQ_REFLECTION=0
QQ_API_TIMEOUT=30
QQ_API_CONNECT_TIMEOUT=12
QQ_TOOL_CALL_TIMEOUT=15
QQ_GLM_WEB_SEARCH=1
QQ_GLM_WEB_SEARCH_ENGINE=search_pro
QQ_GLM_WEB_SEARCH_COUNT=10

# 采样参数
QQ_FACTUAL_TEMPERATURE=0.35
QQ_FACTUAL_TOP_P=0.5
QQ_CASUAL_TEMPERATURE=1.0
QQ_CASUAL_TOP_P=0.95

# API Key 占位
GLM_API_KEY=your_api_key_here
OPENCODE_GO_API_KEY=your_api_key_here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_FREE_API_KEY=your_api_key_here
OPENCODE_FREE_BASE_URL=https://opencode.ai/zen/v1
